{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/jingzhang/ai-governance/experiment_card.schema.json",
  "title": "Bounded Urban Experiment Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "eligible_issue_id",
    "hypothesis",
    "baseline_refs",
    "target_definition",
    "population_or_space",
    "planned_start",
    "planned_end",
    "data_categories",
    "risk_tier",
    "human_owner",
    "authorizations",
    "stop_conditions",
    "rollback_plan",
    "metrics",
    "public_notice",
    "version"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "eligible_issue_id": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "baseline_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "target_definition": {"type": "string", "minLength": 1},
    "comparison_design": {"type": ["string", "null"]},
    "population_or_space": {"type": "string", "minLength": 1},
    "planned_start": {"type": "string", "format": "date-time"},
    "planned_end": {"type": "string", "format": "date-time"},
    "data_categories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk_tier": {"type": "string", "enum": ["low", "medium", "high"]},
    "human_owner": {"type": "string", "minLength": 1},
    "authorizations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "consent_required": {"type": "boolean"},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback_plan": {"type": "string", "minLength": 1},
    "manual_fallback": {"type": ["string", "null"]},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_notice": {"type": "string", "minLength": 1},
    "incident_log_ref": {"type": ["string", "null"]},
    "version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["registered", "authorized", "running", "paused", "stopped", "completed"]}
  }
}
