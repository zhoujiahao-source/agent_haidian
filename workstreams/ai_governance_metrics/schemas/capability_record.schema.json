{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/jingzhang/ai-governance/capability_record.schema.json",
  "title": "Evidence-Bearing Urban Capability Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "name",
    "source_learning_unit",
    "version",
    "status",
    "problem_classes",
    "public_value_evidence_refs",
    "risk_tier",
    "operating_requirements",
    "known_limitations",
    "transfer_requires_revalidation"
  ],
  "properties": {
    "capability_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "source_learning_unit": {
      "type": "string",
      "enum": ["zhongzhiyuan", "ai_origin_community", "dazhongsi", "zhongguancun_service_wing", "xiaoyuehe_scenario_wing"]
    },
    "version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["candidate", "validated_source_context", "transfer_ready", "retired"]},
    "problem_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_value_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk_tier": {"type": "string", "enum": ["low", "medium", "high"]},
    "operating_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "rollback_requirements": {"type": "array", "items": {"type": "string"}},
    "transfer_requires_revalidation": {"const": true},
    "retirement_reason": {"type": ["string", "null"]},
    "evidence_freeze_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
